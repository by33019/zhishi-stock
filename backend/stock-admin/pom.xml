<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>cn.zhishi.stock</groupId><artifactId>stock-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>stock-admin</artifactId>
  <dependencies>
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-common</artifactId><version>${project.version}</version></dependency>
    <!--
      后台用户管理要递增 tokenVersion 并撤销刷新会话（契约 §16.1 的 ADM-USR-05/06/08/09），
      而刷新会话的存储实现与账户读取都在用户域——重复实现一份就会有两处"什么算有效会话"的答案。
    -->
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-system</artifactId><version>${project.version}</version></dependency>
    <!--
      AI 运营取消直接复用 AiTaskStore.requestCancel（原子条件更新，且不带用户条件——
      正是管理员取消需要的语义），不在后台域重写一条 UPDATE。
    -->
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-ai</artifactId><version>${project.version}</version></dependency>
    <!--
      资讯治理（契约 §17）复用资讯域的领域词汇：NewsSource 及其授权状态/来源状态枚举、
      关联状态/方法/目标类型枚举。后台是同一批表（news_source / stock_news_relation）的
      第二个读写方，再造一套"来源状态叫什么"就会出现两个答案。
      关联审核需要的 reviewed_by/reviewed_at 资讯域模型没带，由后台侧的记录类型补充。
    -->
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-news</artifactId><version>${project.version}</version></dependency>
    <!--
      关联目标的对外标识 ↔ 代理键桥接（SECURITY / SECTOR）是行情域的事实
      （SecurityIdentityProvider / SectorIdentityProvider），后台只消费不定义。
    -->
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-market</artifactId><version>${project.version}</version></dependency>
    <!-- 后台查询侧全部是注解式 MyBatis（全项目无 XML mapper） -->
    <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <!--
      一次性密码重置凭证存 Redis（契约 §16.1 ADM-USR-07）。
      强制下线的会话撤销走 stock-system 的 RefreshSessionStore，这里不重复实现。
    -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
    <!--
      AdminUserService 要 BCrypt 哈希临时密码、要 WatchlistGroupService 给新账号建默认分组，
      两者都来自 stock-system（已依赖，此处仅说明用途）。
    -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
