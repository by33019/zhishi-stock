<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>cn.zhishi.stock</groupId><artifactId>stock-parent</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>stock-ai-worker</artifactId>
  <dependencies>
    <!--
      AI 域是主角：任务聚合、执行器、恢复扫描、以及六个 Mapper。
    -->
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-ai</artifactId><version>${project.version}</version></dependency>
    <!--
      行情域与资讯域是**执行任务时的取数来源**：AiContextBuilder 要行情快照、总览与板块，
      以及资讯证据（NewsQueryService）。少任何一个，执行器会在固化上下文那一步失败，
      而失败信息只会说"核心行情缺失"——看不出是装配缺了东西。
    -->
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-market</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-news</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>cn.zhishi.stock</groupId><artifactId>stock-integration</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-redis</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <!--
      显式声明而不是蹭传递依赖：装配里要用 ObjectMapper 建 MarketOverviewJsonCodec，
      以及把 ai_context_snapshot.context_data 序列化成 JSON 列。
      非 Web 应用不会自带它（同 stock-news / stock-job 的处理）。
    -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-json</artifactId></dependency>
    <!--
      任务状态推进要落库：StockAiWorkerApplication 直接用了 @MapperScan / @Mapper，
      这里显式声明而不是蹭 stock-ai 的传递依赖（同 stock-job 的先例）。
    -->
    <dependency><groupId>com.baomidou</groupId><artifactId>mybatis-plus-spring-boot3-starter</artifactId></dependency>
    <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <!--
      集成测试要建真库。生产路径上迁移由 compose 的独立 flyway 服务跑，
      所以应用本身不带 Flyway；测试里只能自己把它带上，否则
      spring.flyway.enabled=true 会因为 FlywayAutoConfiguration 的 @ConditionalOnClass 被跳过，
      症状是"上下文起来了但一张表都没有"。
    -->
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-mysql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>mysql</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins></build>
</project>
