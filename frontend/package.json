{
  "name": "stock-insight-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0",
    "build": "npm run typecheck && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 0.0.0.0",
    "test": "vitest --configLoader runner",
