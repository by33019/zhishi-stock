MYSQL_DATABASE=stock_system
MYSQL_USER=stock
MYSQL_PASSWORD=stock_dev_password
MYSQL_ROOT_PASSWORD=stock_root_dev_password
# 仅影响「从宿主机连入 mysql 容器」的端口映射（见 compose.yaml 的 ports）。
# 容器之间一律走服务名 mysql:3306，与此值无关；后端 DB_URL 因此不需要跟着改。
# 本机 3306 已被其他 MySQL 占用时，在 .env 里改成空闲端口即可。
MYSQL_PORT=3306
REDIS_PASSWORD=stock_redis_dev_password
JWT_SECRET=replace-with-at-least-32-characters-before-use
DEMO_USERNAME=demo
DEMO_PASSWORD=Stock@123
MARKET_SCENARIO=NORMAL
COOKIE_SECURE=false
API_PORT=8080
FRONTEND_PORT=8088

# ---- AI / LLM ----
# SIMULATED（默认）= 确定性占位实现，不产生外网调用与费用，CI 与本地开发用。
# OPENAI_COMPATIBLE = 真实供应商；此时 AI_API_KEY 与 AI_BASE_URL 必填，
#   缺任一项启动即失败（刻意不静默回落到 SIMULATED —— 那会产出一份带着真实证据编号、
#   读起来与真报告无异的占位文本）。
AI_LLM_MODE=SIMULATED
# 真实供应商基地址（需含版本段）。通义 compatible-mode 即 OpenAI 协议：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
# 密钥只放这里（.env 已 gitignore），不要写进代码库或提交到仓库。
AI_API_KEY=
# 供应商编码与模型名，会写入 ai_task / ai_report 便于对账与历史解释。
AI_PROVIDER_CODE=SIMULATED
AI_MODEL_CODE=sim-analyst-v1
# 单次模型调用的总时限。推理模型先产思维链再产正文，需长于普通对话模型。
AI_LLM_TIMEOUT_SECONDS=120
# 单任务超时阈值，必须大于 AI_LLM_TIMEOUT_SECONDS，否则任务先超时而模型还在输出。
AI_TASK_DEADLINE_SECONDS=180
# 提示模板版本，会写进报告。改了系统提示词的输出格式要求就必须同步升版本。
AI_PROMPT_VERSION=p2
